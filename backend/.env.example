# Beispiel fuer die .env. Schluessel traegst du selbst ein; sie werden nie committet,
# geloggt oder an das Frontend ausgeliefert. Dateien werden nur gelesen, nie veraendert.
#
# Suchreihenfolge (erste existierende Datei gewinnt):
#   1. Umgebungsvariable ENV_FILE (beliebiger Pfad)
#   2. <Repo-Root>/.env
#   3. backend/.env
# Echte Prozess-Umgebungsvariablen haben immer Vorrang vor Dateiinhalten.
# Pruefen: python -m backend.check_env   (mit --live: kostenloser Verbindungstest)

# OpenAI-Schluessel (optional)
OPENAI_API_KEY=

# Anthropic-Schluessel (optional)
ANTHROPIC_API_KEY=

# Optional: Standardmodell fuer OpenAI (kein Default im Code; leer = Modell in der App waehlen)
# OPENAI_DEFAULT_MODEL=

# Optional: Standardmodell fuer Anthropic (Default: claude-opus-5-5)
# ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5

# Weitere optionale Einstellungen (Prefix NUTRI_; ALLOWED_ORIGINS und ENABLE_MOCK_PROVIDER auch ohne Prefix):
# ENV_FILE=
# NUTRI_HOST=127.0.0.1
# NUTRI_PORT=8787
# NUTRI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# NUTRI_REQUEST_TIMEOUT_S=60
# NUTRI_RATE_LIMIT_PER_MIN=20
# NUTRI_ENABLE_MOCK_PROVIDER=false
