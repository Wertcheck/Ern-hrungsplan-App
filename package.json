{
  "name": "ernaehrungsplan",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backend": "backend/.venv/bin/python -m backend",
    "backend:test": "backend/.venv/bin/pytest backend/tests -q",
    "bls:test": "python -m pytest scripts/bls/test_bls_import.py -q",
    "e2e:app": "node e2e/app.cjs http://localhost:4173 /tmp/e2e/app",
    "e2e:actions": "node e2e/actions.cjs http://localhost:4173 /tmp/e2e/act",
    "e2e:ai": "node e2e/ai.cjs http://localhost:4173 /tmp/e2e/ai"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
